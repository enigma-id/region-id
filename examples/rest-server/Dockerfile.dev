# Development Dockerfile with hot reload
FROM golang:1.21-alpine

# Install development tools
RUN apk add --no-cache \
    git \
    ca-certificates \
    air \
    delve

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Expose ports
# 8080 - Application
# 2345 - Delve debugger
EXPOSE 8080 2345

# Run with hot reload using air
CMD ["air", "-c", ".air.toml"]
