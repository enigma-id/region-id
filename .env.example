# Docker Compose Environment Configuration
# Copy this file to .env and customize as needed

# PostgreSQL Configuration
POSTGRES_DB=regiondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (internal - for container-to-container communication)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/regiondb?sslmode=disable

# Database URL (external - for accessing from host machine)
DATABASE_URL_EXTERNAL=postgres://postgres:postgres@localhost:5432/regiondb?sslmode=disable

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PORT=6379
REDIS_HOST=redis

# Server Configuration
SERVER_ADDR=:8080
SERVER_PORT=8080

# Development Settings
IS_DEV=true
BUNDEBUG=1

# Logger Settings
LOG_LEVEL=debug
LOG_FORMAT=development

# Migration Settings
MIGRATION_AUTO_RUN=true
